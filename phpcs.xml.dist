<?xml version="1.0"?>
<ruleset name="WBD Real Estate Suite">
	<description>WordPress Coding Standards for WBD Real Estate Suite.</description>
	<file>.</file>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/src/*.js</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<config name="minimum_supported_wp_version" value="6.8"/>
	<config name="testVersion" value="7.4-"/>
	<rule ref="WordPress">
		<!-- PSR-4 file names (Class.php) instead of class-*.php. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wbd-real-estate-suite"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_wbdres"/>
				<element value="wbdres_manage_leads"/>
				<element value="wbdres_view_own_leads"/>
				<element value="edit_wbd_properties"/>
				<element value="edit_others_wbd_properties"/>
				<element value="publish_wbd_properties"/>
				<element value="edit_wbd_agents"/>
				<element value="edit_published_wbd_agents"/>
				<element value="edit_published_wbd_properties"/>
				<element value="delete_wbd_properties"/>
				<element value="delete_published_wbd_properties"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="wbdres"/>
				<element value="Wbdres\RealEstate"/>
			</property>
		</properties>
	</rule>
</ruleset>
