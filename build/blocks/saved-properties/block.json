{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wbdres/saved-properties",
  "version": "1.0.0",
  "title": "Saved Properties",
  "category": "wbd-real-estate",
  "icon": "heart",
  "description": "Favorites, recently viewed or side-by-side comparison — stored privately in the visitor's browser.",
  "keywords": [
    "favorites",
    "wishlist",
    "compare",
    "recently viewed"
  ],
  "textdomain": "wbd-real-estate-suite",
  "attributes": {
    "mode": {
      "type": "string",
      "default": "favorites",
      "enum": [
        "favorites",
        "recent",
        "compare"
      ]
    },
    "columns": {
      "type": "number",
      "default": 3
    },
    "title": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "style": "wbdres-frontend",
  "render": "file:./render.php",
  "variations": [
    {
      "name": "recent",
      "title": "Recently Viewed Properties",
      "icon": "backup",
      "attributes": {
        "mode": "recent"
      },
      "isActive": [
        "mode"
      ],
      "scope": [
        "inserter",
        "transform"
      ]
    },
    {
      "name": "compare",
      "title": "Property Comparison",
      "icon": "columns",
      "attributes": {
        "mode": "compare"
      },
      "isActive": [
        "mode"
      ],
      "scope": [
        "inserter",
        "transform"
      ]
    }
  ],
  "example": {
    "attributes": {}
  }
}