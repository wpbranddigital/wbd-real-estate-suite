    "lint:css": "wp-scripts lint-style \"src/**/*.scss\"",
    "format": "wp-scripts format src",
    "plugin-zip": "wp-scripts plugin-zip"
  },
  "devDependencies": {
    "@wordpress/scripts": "^31.0.0",
    "ajv": "^8.20.0"
  }
}
